#include <stdio.h>

int main() {
    char str[] = "hello";
    int freq[256] = {0};

    for (int i = 0; str[i] != '\0'; i++)
        freq[(int)str[i]]++;

    for (int i = 0; str[i] != '\0'; i++)
        if (freq[(int)str[i]] > 1) {
            printf("First Repeating = '%c'\n", str[i]);
            return 0;
        }

    printf("No Repeating Character Found\n");

    return 0;
}