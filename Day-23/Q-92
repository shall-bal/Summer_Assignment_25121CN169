#include <stdio.h>

int main() {
    char str[] = "hello world";
    int freq[256] = {0};

    for (int i = 0; str[i] != '\0'; i++)
        freq[(int)str[i]]++;

    int max = 0;
    char result;
    for (int i = 0; i < 256; i++)
        if (freq[i] > max) {
            max = freq[i];
            result = (char)i;
        }

    printf("Max Occurring = '%c' (%d times)\n", result, max);

    return 0;
}