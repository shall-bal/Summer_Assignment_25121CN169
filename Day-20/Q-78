#include <stdio.h>

int main() {
    int A[3][3] = {{1, 2, 3},
                   {2, 4, 5},
                   {3, 5, 6}};
    int symmetric = 1;

    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            if (A[i][j] != A[j][i]) {
                symmetric = 0;
                break;
            }

    if (symmetric)
        printf("Matrix is Symmetric\n");
    else
        printf("Matrix is Not Symmetric\n");

    return 0;
}