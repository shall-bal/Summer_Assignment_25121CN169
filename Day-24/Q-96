#include <stdio.h>

int main() {
    char str[] = "hello world";
    int seen[256] = {0};
    int j = 0;

    for (int i = 0; str[i] != '\0'; i++)
        if (!seen[(int)str[i]]) {
            seen[(int)str[i]] = 1;
            str[j++] = str[i];
        }
    str[j] = '\0';

    printf("Result = %s\n", str);

    return 0;
}