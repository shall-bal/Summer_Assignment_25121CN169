#include <stdio.h>
#include <string.h>

int main() {
    char str1[] = "hello";
    char str2[] = "llohe";
    char doubled[100];

    strcpy(doubled, str1);
    strcat(doubled, str1);

    if (strlen(str1) == strlen(str2) && strstr(doubled, str2))
        printf("'%s' is a Rotation of '%s'\n", str2, str1);
    else
        printf("'%s' is Not a Rotation of '%s'\n", str2, str1);

    return 0;
}