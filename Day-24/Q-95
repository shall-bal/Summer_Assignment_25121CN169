#include <stdio.h>
#include <string.h>

int main() {
    char str[] = "Find the longest word in sentence";
    char longest[50] = "", current[50] = "";
    int i = 0, j = 0;

    while (str[i] != '\0') {
        if (str[i] != ' ')
            current[j++] = str[i];
        else {
            current[j] = '\0';
            if (strlen(current) > strlen(longest))
                strcpy(longest, current);
            j = 0;
        }
        i++;
    }
    current[j] = '\0';
    if (strlen(current) > strlen(longest))
        strcpy(longest, current);

    printf("Longest Word = %s\n", longest);

    return 0;
}