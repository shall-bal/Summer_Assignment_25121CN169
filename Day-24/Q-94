#include <stdio.h>

int main() {
    char str[] = "aaabbbccddddee";
    int i = 0;

    while (str[i] != '\0') {
        char c = str[i];
        int count = 0;

        while (str[i] == c) {
            count++;
            i++;
        }

        printf("%c%d", c, count);
    }
    printf("\n");

    return 0;
}