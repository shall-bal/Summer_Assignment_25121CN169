#include <stdio.h>

int main() {
    char str1[] = "hello";
    char str2[] = "world";
    int freq1[256] = {0};
    int freq2[256] = {0};

    for (int i = 0; str1[i] != '\0'; i++)
        freq1[(int)str1[i]]++;

    for (int i = 0; str2[i] != '\0'; i++)
        freq2[(int)str2[i]]++;

    printf("Common Characters = ");
    for (int i = 0; i < 256; i++)
        if (freq1[i] > 0 && freq2[i] > 0)
            printf("'%c' ", (char)i);
    printf("\n");

    return 0;
}