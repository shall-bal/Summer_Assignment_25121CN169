#include <stdio.h>
#include <string.h>

int main() {
    char words[][20] = {"Banana", "Hi", "Mango", "A", "Cherry"};
    int n = 5;
    char temp[20];

    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++)
            if (strlen(words[i]) > strlen(words[j])) {
                strcpy(temp, words[i]);
                strcpy(words[i], words[j]);
                strcpy(words[j], temp);
            }

    printf("Sorted by Length:\n");
    for (int i = 0; i < n; i++)
        printf("%s\n", words[i]);

    return 0;
}