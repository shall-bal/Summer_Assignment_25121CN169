#include <stdio.h>

int main() {
    int A[] = {1, 3, 5, 7};
    int B[] = {2, 4, 6, 8};
    int n = 4, m = 4;
    int C[8];
    int i = 0, j = 0, k = 0;

    while (i < n && j < m)
        if (A[i] < B[j])
            C[k++] = A[i++];
        else
            C[k++] = B[j++];

    while (i < n)
        C[k++] = A[i++];

    while (j < m)
        C[k++] = B[j++];

    for (int i = 0; i < n + m; i++)
        printf("%d ", C[i]);
    printf("\n");

    return 0;
}