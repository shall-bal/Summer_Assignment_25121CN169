#include <stdio.h>

int main() {
    int ans, score = 0;

    printf("What is 2 + 2?\n");
    printf("1. 3\n2. 4\n3. 5\n");
    scanf("%d", &ans);

    if(ans == 2)
        score++;

    printf("What is the capital of India?\n");
    printf("1. Delhi\n2. Mumbai\n3. Chennai\n");
    scanf("%d", &ans);

    if(ans == 1)
        score++;

    printf("Score = %d", score);

    return 0;
}