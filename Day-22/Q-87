#include <stdio.h>

int main() {
    char str[] = "hello world";

    for (char c = 'a'; c <= 'z'; c++) {
        int count = 0;
        for (int i = 0; str[i] != '\0'; i++)
            if (str[i] == c)
                count++;
        if (count > 0)
            printf("'%c' = %d\n", c, count);
    }

    return 0;
}