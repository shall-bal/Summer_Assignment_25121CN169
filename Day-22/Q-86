#include <stdio.h>

int main() {
    char str[] = "Hello World How Are You";
    int count = 0, i = 0;

    while (str[i] != '\0') {
        if (str[i] == ' ' && str[i + 1] != ' ' && str[i + 1] != '\0')
            count++;
        i++;
    }
    count++;

    printf("Word Count = %d\n", count);

    return 0;
}