#include <stdio.h>
#include <string.h>

int main() {
    char str[] = "madam";
    int n = strlen(str);
    int palindrome = 1;

    for (int i = 0; i < n / 2; i++)
        if (str[i] != str[n - i - 1]) {
            palindrome = 0;
            break;
        }

    if (palindrome)
        printf("'%s' is a Palindrome\n", str);
    else
        printf("'%s' is Not a Palindrome\n", str);

    return 0;
}