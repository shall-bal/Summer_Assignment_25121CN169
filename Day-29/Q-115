#include <stdio.h>
#include <string.h>

int main() {
    char str[100];

    printf("Enter a string: ");
    scanf("%s", str);

    printf("1. Length\n2. Reverse\n3. Display\n");

    int choice;
    printf("Enter choice: ");
    scanf("%d", &choice);

    if(choice == 1) {
        printf("Length = %d", strlen(str));
    }
    else if(choice == 2) {
        for(int i = strlen(str) - 1; i >= 0; i--)
            printf("%c", str[i]);
    }
    else if(choice == 3) {
        printf("%s", str);
    }
    else {
        printf("Invalid Choice");
    }

    return 0;
}