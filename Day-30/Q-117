#include <stdio.h>

int main() {
    char name[50];
    int marks[3], i, total = 0;

    printf("Enter student name: ");
    scanf("%s", name);

    printf("Enter 3 marks: ");
    for(i = 0; i < 3; i++) {
        scanf("%d", &marks[i]);
        total += marks[i];
    }

    printf("\nStudent Record\n");
    printf("Name: %s\n", name);
    printf("Total Marks: %d\n", total);

    return 0;
}